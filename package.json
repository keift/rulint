{
  "name": "rulint",
  "version": "1.1.16",
  "description": "Strict ESLint presets for modern TypeScript.",
  "license": "MIT",
  "homepage": "https://github.com/keift/rulint",
  "bugs": "https://github.com/keift/rulint/issues",
  "exports": {
    ".": {
      "import": "./dist/main.mjs",
      "types": "./dist/main.d.mts"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "types": "./dist/types.d.mts"
    }
  },
  "scripts": {
    "tests": "bun run lint && bun test",
    "retouch": "bun run prettier",
    "build": "tsdown",
    "prettier": "prettier --write ./",
    "lint": "eslint ./"
  },
  "dependencies": {
    "@eslint/js": "latest",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-plugin-prefer-arrow-functions": "latest",
    "eslint-plugin-zod": "latest",
    "jiti": "latest",
    "lodash.merge": "^4.6.2",
    "typescript": "6",
    "typescript-eslint": "latest"
  },
  "devDependencies": {
    "@types/json2md": "latest",
    "json2md": "latest",
    "prettier": "latest",
    "tsdown": "latest",
    "unrun": "latest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keift/rulint"
  },
  "keywords": [
    "lint",
    "eslint",
    "typescript-eslint"
  ]
}
